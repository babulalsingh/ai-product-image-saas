PORT=3000
NODE_ENV=development
OPENAI_API_KEY=replace_with_your_secret_api_key
OPENAI_IMAGE_MODEL=gpt-image-1
# Firebase Admin SDK: either set GOOGLE_APPLICATION_CREDENTIALS to a service-account JSON path,
# or use the hosting provider's Application Default Credentials.
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
# For Firebase ID token verification, use your Firebase project's Web API key only in public client config.
